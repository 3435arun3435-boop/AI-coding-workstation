# AI Software Engineering Workstation — environment variables
#
# This file is a SAFE TEMPLATE: copy it to `.env` and fill in values.
# NEVER put real keys in this file — `.env` is git-ignored.
#
# The workstation's primary credential store is its own provider
# configuration (stored masked in ~/.coding-agent/config.json, managed via
# the UI or POST /api/providers). The variables below are optional
# overrides read by server.js / cli.js.

# Server
PORT=3300
AGENT_DATA_DIR=

# Optional: provider keys used only by external tooling/scripts.
# Prefer configuring providers through the app (masked at rest).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: local model server
OLLAMA_BASE_URL=http://localhost:11434
